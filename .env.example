# CardFlip environment — copy to .env.local for dev. Production values live in
# the Vercel project's environment variables (Settings → Environment Variables).

# Database (Turso in production; leave both empty for a local SQLite file at data/)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Card reading + help robot (Anthropic)
ANTHROPIC_API_KEY=

# Catalogue
POKEMONTCG_API_KEY=

# eBay (sell.inventory / sell.marketing / sell.fulfillment / sell.finances)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_INSIGHTS_ENABLED=
EBAY_TOKEN_KEY=
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=https://cardflip.io/api/ebay/account-deletion
# Listing-API drafts (sell.item.draft) — opt-in once eBay grants the scope
EBAY_DRAFT_SCOPE=

# Admin console (defaults to admin/password when unset — never leave that on prod)
ADMIN_PANEL_USER=
ADMIN_PANEL_PASSWORD=

# Mail (password resets, welcome, watchlist alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Daily job auth (Vercel Cron → /api/cron/daily)
CRON_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://cardflip.io
NEXT_PUBLIC_BASE_PATH=
# Stamped by the build so the account page can show which deploy a phone runs
NEXT_PUBLIC_BUILD_SHA=
# Dev only: one-tap login on the login page
NEXT_PUBLIC_DEV_LOGIN=
NEXT_PUBLIC_DEV_LOGIN_EMAIL=
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=

# Stripe ($9.99 CardFlip + $24.99 Pro)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# PSA cert lookups (free tier; prod IPs are blocked at PSA's edge today)
PSA_API_TOKEN=

# Scripts only (backfill-mtgjson / backfill-tcgcsv / export-mtg-mirror): local SQLite path
CARDFLIP_DB_PATH=
