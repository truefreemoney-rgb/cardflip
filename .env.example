# CardFlip environment — copy to .env.local for dev; on Fly these are secrets
# (`flyctl secrets set KEY=value --app cardflip-superior`).
# Everything is optional: each feature degrades honestly (503 / "unconfigured")
# when its keys are missing, so a bare checkout still runs the scanner off the
# local mirrors.

# --- Identification / pricing ------------------------------------------------
# Claude vision reads the card photo (primary identifier; OCR is the fallback).
ANTHROPIC_API_KEY=
# pokemontcg.io — Pokémon prices + upstream search when the mirror misses.
# Works without a key at a lower rate limit.
POKEMONTCG_API_KEY=

# --- eBay -------------------------------------------------------------------
# App keyset (developer.ebay.com → Application Keys, Production).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName from "User Tokens → Get a Token from eBay via Your Application".
EBAY_RU_NAME=
# Marketplace Insights (sold comps) — eBay DENIED access 2026-08-16 (partner-
# only). Leave unset; set to 1 only if access is ever granted.
EBAY_INSIGHTS_ENABLED=
# 32-byte hex key for AES-256-GCM encryption of sellers' OAuth tokens at rest.
# Defaults to deriving from EBAY_CLIENT_SECRET; set explicitly so rotating the
# client secret doesn't invalidate every stored token.
EBAY_TOKEN_KEY=
# Marketplace account-deletion notifications (required by eBay for prod
# keysets). Token is 32–80 chars, chosen by us, pasted into the eBay portal;
# URL must match what's registered there exactly.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=https://cardflip-superior.fly.dev/api/ebay/account-deletion

# --- Accounts / mail --------------------------------------------------------
# The operator's login email — promoted to admin on first visit to /admin.
ADMIN_EMAIL=
# Password-reset email. Without SMTP the "forgot password" route answers 503
# and points at support@; `node scripts/issue-reset-link.mjs <email>` still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional From header; defaults to "CardFlip <SMTP_USER>".
MAIL_FROM=

# --- Site / storage ---------------------------------------------------------
# Absolute origin used for reset links, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL=https://cardflip-superior.fly.dev
# Only if hosting under a sub-path; leave empty.
NEXT_PUBLIC_BASE_PATH=
# SQLite file for the operator scripts (sync-*, export-mtg-mirror,
# issue-reset-link). Defaults to ./data/cardflip.db; the app itself resolves
# the same path in src/lib/db.ts (on Fly: the volume at /app/data).
CARDFLIP_DB_PATH=
