    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "admin": "node scripts/create-admin.mjs",
    "sync:jp": "node scripts/sync-cards.mjs ja jp_cards",
    "sync:zh": "node scripts/sync-cards.mjs zh-tw zh_cards",
    "sync:species": "node scripts/sync-species-names.mjs",
    "test:ebay": "node --experimental-strip-types --no-warnings scripts/test-ebay-comps.mjs",
    "test:inventory": "node --experimental-strip-types --no-warnings scripts/test-ebay-inventory.mjs",
    "test:ocr": "node --experimental-strip-types --no-warnings scripts/test-ocr-text.mjs",
    "test:cardnumber": "node --experimental-strip-types --no-warnings scripts/test-card-number.mjs",
    "sync:en": "node scripts/sync-cards.mjs en en_cards",
    "sync:mtg": "node --experimental-strip-types --no-warnings scripts/sync-mtg.mjs",
    "export:mtg": "node scripts/export-mtg-mirror.mjs",
    "test:pricing": "node --experimental-strip-types --no-warnings scripts/test-pricing.mjs",
    "test:mtg": "node --experimental-strip-types --no-warnings scripts/test-mtg.mjs",
    "test:ratelimit": "node --experimental-strip-types --no-warnings scripts/test-rate-limit.mjs",
