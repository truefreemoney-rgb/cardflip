{
  "expo": {
    "name": "CardFlip",
    "slug": "cardflip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cardflip",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0b11",
    "ios": {
      "bundleIdentifier": "io.cardflip.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "CardFlip uses the camera to scan your cards and show what they are worth.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0b11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-apple-authentication",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "scan",
              "title": "Scan a card",
              "subtitle": "See what it is worth",
              "icon": "symbol:camera.viewfinder",
              "params": {
                "href": "/scan"
              }
            }
          ]
        }
      ],
      "expo-app-intents"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "9d77fb7b-b993-4c2c-8d71-d0bd6829db09"
      }
    },
    "owner": "cardflip"
  }
}
